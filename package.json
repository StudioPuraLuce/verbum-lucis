{
  "name": "verbum-lucis",
  "version": "1.0.0",
  "description": "Portale liturgico cattolico italiano",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "cf:types": "wrangler types",
    "db:schema:local": "wrangler d1 execute verbum-lucis --local --file=./drizzle/0000_init.sql",
    "db:seed:local": "wrangler d1 execute verbum-lucis --local --file=./drizzle/seed.sql",
    "db:schema:remote": "wrangler d1 execute verbum-lucis --remote --file=./drizzle/0000_init.sql",
    "db:seed:remote": "wrangler d1 execute verbum-lucis --remote --file=./drizzle/seed.sql",
    "seed:gen": "tsx scripts/gen-seed-sql.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "drizzle-orm": "^0.29.3",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260116.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.42.0"
  }
}
