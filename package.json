{
  "name": "verbum-lucis",
  "version": "1.0.0",
  "description": "Portale liturgico cattolico italiano",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:seed": "tsx scripts/seed.js",
    "db:backup": "pg_dump $DATABASE_URL > backups/backup-$(date +%Y%m%d).sql",
    "import:dioceses": "tsx scripts/import-dioceses.js",
    "import:catechism": "tsx scripts/import-catechism.js",
    "import:intentions": "tsx scripts/import-intentions.js",
    "import:prayers": "tsx scripts/import-prayers.js",
    "import:saints": "tsx scripts/import-saints.js",
    "scrape:saints": "node scripts/scrape-saints.js",
    "import:all": "npm run import:dioceses && npm run import:saints && npm run import:prayers && npm run import:intentions",
    "update-liturgy": "tsx scripts/update-liturgy.js",
    "update-liturgy:all": "tsx scripts/update-liturgy.js --all --days 7",
    "sync-saints": "tsx scripts/sync-saints.js",
    "setup-cron": "bash scripts/setup-cron.sh",
    "migrate:theme-tags": "tsx scripts/migrate-theme-tags.js",
    "verify:theme-tags": "tsx scripts/verify-theme-tags.js",
    "import:bible": "tsx scripts/import-bible.js",
    "import:bible-verses": "tsx scripts/import-bible-verses.js",
    "import:bible-demo": "tsx scripts/import-bible-demo.js",
    "import:airtable": "tsx scripts/import-airtable.js",
    "import:sheets": "tsx scripts/import-sheets.js",
    "import:csv": "tsx scripts/import-csv.js",
    "import:external": "tsx scripts/import-external.js",
    "populate:dioceses": "tsx scripts/populate-dioceses-mcp.js"
  },
  "dependencies": {
    "airtable": "^0.12.2",
    "csv-parse": "^5.5.3",
    "googleapis": "^131.0.0",
    "@astrojs/node": "^9.5.2",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.29.3",
    "lucide-react": "^0.323.0",
    "postgres": "^3.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "drizzle-kit": "^0.20.13",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
