---
/**
 * PhotoSlot — segnaposto elegante per le FOTO REALI dell'utente.
 * Se `src` è presente → renderizza la foto (con trattamento premium).
 * Altrimenti → segnaposto neutro (texture carta + cornice oro) con
 * l'etichetta di QUALE foto va caricata lì. Nessuna immagine inventata.
 *
 * Le foto vanno in `public/foto/…` e passate come `src="/foto/nome.jpg"`.
 */
interface Props {
  src?: string;
  alt?: string;
  label?: string;      // es. "pagina sacra di oggi" — guida su cosa caricare
  ratio?: string;      // es. "4/5", "16/9", "1/1"
  class?: string;
  overlay?: boolean;   // scurisce per testo sovrapposto
}
const {
  src,
  alt = '',
  label = 'foto',
  ratio = '4/5',
  class: klass = '',
  overlay = false,
} = Astro.props;
---

{src ? (
  <figure class={`relative overflow-hidden rounded-xl ring-1 ring-gold/25 shadow-sm ${klass}`} style={`aspect-ratio:${ratio}`}>
    <img src={src} alt={alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
    {overlay && <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>}
  </figure>
) : (
  <div
    class={`photo-slot relative flex flex-col items-center justify-center overflow-hidden rounded-xl ring-1 ring-gold/30 ${klass}`}
    style={`aspect-ratio:${ratio}`}
    role="img"
    aria-label={`Segnaposto foto: ${label}`}
  >
    <!-- cornice interna sottile -->
    <div class="pointer-events-none absolute inset-2 rounded-lg border border-gold/20"></div>
    <svg class="mb-3 h-7 w-7 text-gold/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <circle cx="9" cy="9" r="2" />
      <path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L5 21" />
    </svg>
    <span class="kicker text-muted-foreground/80">{label}</span>
  </div>
)}
