---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db, schema } from '../../db';
import { format } from 'date-fns';
import { it } from 'date-fns/locale';
import { eq } from 'drizzle-orm';

export const prerender = false;

const oggi = new Date().toISOString().split('T')[0];

// Fetch Pagina Sacra di oggi
let paginaSacra = null;
try {
  paginaSacra = await db.query.pagineSacre.findFirst({
    where: (t, { eq }) => eq(t.data, oggi),
  });
} catch { paginaSacra = null; }

// Se non esiste, redirect alla homepage
if (!paginaSacra) {
  return Astro.redirect('/');
}

// Fetch liturgia collegata
const liturgia = paginaSacra.liturgyId
  ? await db.query.liturgy.findFirst({
      where: (t, { eq }) => eq(t.id, paginaSacra.liturgyId!),
    })
  : null;

// Increment views
try {
  await db.update(schema.pagineSacre)
    .set({ views: (paginaSacra.views || 0) + 1 })
    .where(eq(schema.pagineSacre.id, paginaSacra.id));
} catch {}

const oggiFormat = format(new Date(oggi), 'EEEE d MMMM yyyy', { locale: it });
---

<BaseLayout
  title={`Pagina Sacra — ${oggiFormat}`}
  description={`Vangelo incarnato, Fuoco nel corpo, Regno nella carne. La Pagina Sacra di oggi per vivere il Vangelo concretamente.`}
>
  <article class="max-w-4xl mx-auto">

    <!-- Intestazione -->
    <header class="text-center mb-12 border-b pb-8">
      <div class="text-6xl mb-6">☩</div>
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">
        Pagina Sacra
      </h1>
      <p class="text-2xl text-muted-foreground mb-2">
        {oggiFormat}
      </p>
      {liturgia && (
        <div class="flex flex-wrap justify-center items-center gap-3 mt-4">
          <span class={`px-4 py-2 rounded-full text-sm font-semibold liturgical-color-${liturgia.coloreLiturgico}`}>
            {liturgia.coloreLiturgico.charAt(0).toUpperCase() + liturgia.coloreLiturgico.slice(1)}
          </span>
          <span class="text-sm text-muted-foreground">
            {liturgia.tempoLiturgico}
          </span>
          {liturgia.domenicaSettimana && (
            <span class="text-sm font-semibold text-primary">
              {liturgia.domenicaSettimana}
            </span>
          )}
        </div>
      )}
      <p class="text-sm text-muted-foreground mt-4 italic">
        Fuoco nel corpo · Presenza nel giorno · Regno nella carne
      </p>
    </header>

    <!-- IL RE OGGI -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">👑</span> Il Re Oggi...
      </h2>
      <div class="rounded-lg border-2 border-primary/30 bg-gradient-to-br from-primary/5 to-primary/10 p-8">
        <div class="prose prose-lg max-w-none" set:html={paginaSacra.reOggi} />
      </div>
    </section>

    <!-- IL VANGELO OGGI -->
    {liturgia && (
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
          <span>✦</span> Il Vangelo Oggi
        </h2>
        <div class="rounded-lg border-2 border-primary/20 bg-card p-8">
          <p class="text-sm text-muted-foreground mb-6 font-semibold">
            {liturgia.vangelo.riferimento}
          </p>
          <div class="prayer-text text-lg leading-relaxed whitespace-pre-line">
            {liturgia.vangelo.testo}
          </div>
        </div>
      </section>
    )}

    <!-- FUOCO NEL CORPO -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">🔥</span> Fuoco nel Corpo
      </h2>
      <div class="rounded-lg border bg-card p-8">
        <div class="prose prose-lg max-w-none" set:html={paginaSacra.fuocoNelCorpo} />
      </div>
    </section>

    <!-- PRESENZA NEL GIORNO -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">👁</span> Presenza nel Giorno
      </h2>
      <div class="rounded-lg border bg-card p-8">
        <div class="prose prose-lg max-w-none" set:html={paginaSacra.presenzaNelGiorno} />
      </div>
    </section>

    <!-- REGNO NELLA CARNE -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">👣</span> Regno nella Carne
      </h2>
      <div class="rounded-lg border bg-card p-8">
        <div class="prose prose-lg max-w-none" set:html={paginaSacra.regnoNellaCarne} />
      </div>
    </section>

    <!-- ROSARIO INTERIORE -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">📿</span> Rosario Interiore
      </h2>
      <div class="rounded-lg border bg-gradient-to-br from-primary/5 to-primary/10 p-8">
        <div class="space-y-4">
          <div>
            <p class="text-sm text-muted-foreground mb-1 font-semibold">Mistero ispirato dal Vangelo:</p>
            <p class="text-lg italic">{paginaSacra.rosarioInteriore.misteroIspirato}</p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground mb-1 font-semibold">Mistero del Rosario tradizionale:</p>
            <p class="text-lg italic">{paginaSacra.rosarioInteriore.misteroProgressivo}</p>
          </div>
          <div class="mt-6 pt-6 border-t">
            <p class="text-sm text-muted-foreground mb-3">📿 Recita questa decina oggi:</p>
            <blockquote class="border-l-4 border-primary pl-6 italic text-lg leading-relaxed">
              {paginaSacra.rosarioInteriore.preghiera}
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- GESTO REALE DEL GIORNO -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">🔖</span> Gesto Reale del Giorno
      </h2>
      <div class="rounded-lg border-2 border-primary bg-gradient-to-br from-primary/10 to-primary/5 p-8">
        <h3 class="text-2xl font-bold mb-4">{paginaSacra.gestoReale.titolo}</h3>
        <p class="text-lg mb-6 leading-relaxed">{paginaSacra.gestoReale.spiegazione}</p>
        
        <div class="mb-6">
          <p class="font-semibold mb-3">Esempi concreti:</p>
          <ul class="space-y-2">
            {paginaSacra.gestoReale.esempi.map(esempio => (
              <li class="flex items-start gap-3">
                <span class="text-primary mt-1 flex-shrink-0">→</span>
                <span>{esempio}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-6 border-t">
          <p class="text-sm text-muted-foreground mb-2">Quando hai finito, sussurra:</p>
          <blockquote class="text-xl font-semibold italic text-primary text-center py-4">
            "{paginaSacra.gestoReale.fraseDaDire}"
          </blockquote>
        </div>
      </div>
    </section>

    <!-- L'AVVERSARIO OGGI POTREBBE -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">⚠️</span> L'Avversario oggi potrebbe...
      </h2>
      <div class="rounded-lg border border-destructive/30 bg-destructive/5 p-8">
        <ul class="space-y-3 mb-6">
          {paginaSacra.avversario.tentazioni.map(tentazione => (
            <li class="flex items-start gap-3">
              <span class="text-destructive mt-1 flex-shrink-0">✗</span>
              <span>{tentazione}</span>
            </li>
          ))}
        </ul>
        <div class="pt-6 border-t border-destructive/20">
          <p class="font-semibold mb-2">Antidoto — Ripeti:</p>
          <blockquote class="text-xl font-bold text-primary italic">
            "{paginaSacra.avversario.antidoto}"
          </blockquote>
        </div>
      </div>
    </section>

    <!-- OGGI CAMMINO COME CHI -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span>✦</span> Oggi cammino come chi...
      </h2>
      <div class="rounded-lg bg-accent/30 p-8 text-center">
        <p class="text-xl italic leading-relaxed">
          {paginaSacra.camminoIdentita}
        </p>
      </div>
    </section>

    <!-- FRASE DA INCIDERE NEL DIARIO -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold mb-6 flex items-center gap-3 font-serif">
        <span class="text-4xl">📖</span> Frase da incidere nel Diario
      </h2>
      <div class="rounded-lg border-2 border-primary/30 bg-gradient-to-br from-primary/5 to-background p-12 text-center">
        <blockquote class="text-2xl font-serif italic leading-relaxed">
          «{paginaSacra.fraseDiario}»
        </blockquote>
      </div>
    </section>

    <!-- Navigation -->
    <div class="flex items-center justify-between pt-8 border-t">
      {(() => {
        const d = new Date(oggi);
        const prev = new Date(d); prev.setDate(d.getDate() - 1);
        const next = new Date(d); next.setDate(d.getDate() + 1);
        const fmt = (date: Date) => date.toISOString().split('T')[0];
        return (
          <>
            <a href={`/pagina-sacra/${fmt(prev)}`} class="text-primary hover:underline flex items-center gap-2">
              <span>←</span>
              <span>Ieri</span>
            </a>
            <a href="/liturgia/oggi" class="text-muted-foreground hover:text-primary text-sm">
              Liturgia completa
            </a>
            <a href={`/pagina-sacra/${fmt(next)}`} class="text-primary hover:underline flex items-center gap-2">
              <span>Domani</span>
              <span>→</span>
            </a>
          </>
        );
      })()}
    </div>

    <!-- Footer info -->
    <div class="mt-12 pt-8 border-t text-center text-sm text-muted-foreground">
      <p class="mb-2">
        ☩ Pagina Sacra — Un progetto di <strong>Verbum Lucis</strong> · Studio Pura Luce
      </p>
      <p class="italic">
        Fuoco nel corpo · Presenza nel giorno · Regno nella carne
      </p>
    </div>

  </article>

  <style>
    /* Stili specifici per Pagina Sacra */
    .prose blockquote {
      @apply border-l-4 border-primary pl-6 italic my-6;
    }
    
    .prose h3 {
      @apply text-2xl font-bold mb-4 mt-8;
    }

    .prose p {
      @apply mb-4 leading-relaxed;
    }
  </style>
</BaseLayout>
