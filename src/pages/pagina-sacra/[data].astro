---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaSacraArticle from '../../components/PaginaSacraArticle.astro';
import { getDb, schema } from '../../db';
import { liturgicalCoordinate, type Colore } from '../../lib/liturgical-spiral';
import { format } from 'date-fns';
import { it } from 'date-fns/locale';
import { eq } from 'drizzle-orm';

export const prerender = false;

const { data: dataParam } = Astro.params;
const oggi = new Date().toISOString().split('T')[0];

// Data odierna: canonicalizza su /oggi
if (dataParam === oggi) return Astro.redirect('/pagina-sacra/oggi');
if (!dataParam || !/^\d{4}-\d{2}-\d{2}$/.test(dataParam)) return Astro.redirect('/pagina-sacra/oggi');

const db = getDb(Astro.locals);
let paginaSacra = null;
try {
  paginaSacra = await db.query.pagineSacre.findFirst({
    where: (t, { eq }) => eq(t.data, dataParam),
  });
} catch { paginaSacra = null; }

// NB: le Pagine REALI del corpus (testimonianza privata) NON si mostrano qui, sul portale
// pubblico. Restano private: alimentano il generatore come contesto e/o si leggono in una
// futura vista privata protetta. Vedi corpus/README.md.

const dObj = new Date(dataParam + 'T00:00:00');
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const dataUmana = cap(format(dObj, 'EEEE d MMMM yyyy', { locale: it }));

const prev = new Date(dObj); prev.setDate(dObj.getDate() - 1);
const next = new Date(dObj); next.setDate(dObj.getDate() + 1);
const fmt = (x: Date) => x.toISOString().split('T')[0];

// ─── Coordinata liturgica (motore self-contained, sempre disponibile) ───
const coord = liturgicalCoordinate(dataParam);
const ACCENT: Record<Colore, string> = {
  verde: '#3f7a4e', viola: '#6a4a94', bianco: '#a6792f', rosso: '#9a2f2a', rosa: '#b96b86',
};
const accent = ACCENT[coord.colore];
const coloreLabel = cap(coord.colore);
const tempoLabel = `${coord.tempoLabel}${coord.settimanaRomana ? ` · ${coord.settimanaRomana}` : ''}`;

let liturgia = null;
if (paginaSacra) {
  liturgia = paginaSacra.liturgyId
    ? await db.query.liturgy.findFirst({ where: (t, { eq }) => eq(t.id, paginaSacra.liturgyId!) })
    : null;
  try {
    await db.update(schema.pagineSacre)
      .set({ views: (paginaSacra.views || 0) + 1 })
      .where(eq(schema.pagineSacre.id, paginaSacra.id));
  } catch {}
}
---

<BaseLayout
  title={`Pagina Sacra — ${dataUmana}`}
  description={`La Pagina Sacra di ${dataUmana}: Vangelo incarnato, Fuoco nel corpo, Regno nella carne.`}
>
  {paginaSacra ? (
    <PaginaSacraArticle
      reOggi={paginaSacra.reOggi}
      fuocoNelCorpo={paginaSacra.fuocoNelCorpo}
      presenzaNelGiorno={paginaSacra.presenzaNelGiorno}
      regnoNellaCarne={paginaSacra.regnoNellaCarne}
      rosarioInteriore={paginaSacra.rosarioInteriore}
      gestoReale={paginaSacra.gestoReale}
      avversario={paginaSacra.avversario}
      camminoIdentita={paginaSacra.camminoIdentita}
      fraseDiario={paginaSacra.fraseDiario}
      dataUmana={dataUmana}
      tempoLabel={tempoLabel}
      coloreLabel={coloreLabel}
      accent={accent}
      vangeloRif={liturgia?.vangelo?.riferimento ?? null}
      vangeloTesto={liturgia?.vangelo?.testo ?? null}
      prevHref={`/pagina-sacra/${fmt(prev)}`}
      nextHref={`/pagina-sacra/${fmt(next)}`}
    />
  ) : (
    <div class="max-w-xl mx-auto py-16">
      <div class="rounded-2xl border border-gold/25 bg-card p-8 text-center shadow-sm">
        <div class="text-4xl mb-4" style={`color:${accent}`}>☩</div>
        <span class="kicker text-gold">Sulla spirale</span>
        <h1 class="font-display text-3xl mt-1 mb-1 capitalize">{dataUmana}</h1>
        <p class="text-sm text-muted-foreground">
          {tempoLabel} · <span class="capitalize">{coloreLabel}</span> · Anno {coord.cicloDomenicale} · {coord.vangeloTonalita.evangelista}
        </p>

        {coord.centro && (
          <div class="mt-5 rounded-lg bg-accent/60 p-4">
            <span class="kicker text-gold">Centro risvegliato</span>
            <p class="mt-1 font-display text-xl">{coord.centro}</p>
            {coord.lavoro && <p class="text-sm text-muted-foreground italic">il lavoro: {coord.lavoro}</p>}
          </div>
        )}

        <p class="text-muted-foreground mt-6 mb-5 text-sm">Questo giorno non è ancora stato scritto.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/spirale" class="inline-flex h-10 items-center rounded-lg border border-gold/40 px-5 text-sm font-medium transition hover:bg-accent">← La Spirale</a>
          <a href="/pagina-sacra/oggi" class="inline-flex h-10 items-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:brightness-110">Pagina Sacra di oggi →</a>
        </div>
      </div>
    </div>
  )}
</BaseLayout>
