---
/**
 * Bible Homepage
 * Route: /bibbia
 *
 * Displays:
 * - Introduction to Bible (Catholic perspective)
 * - Testament division (OT/NT) with book grid
 * - Popular verses
 * - Daily verse feature
 */

import { db, bibleBooks } from '../../db';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

// Get books organized by testament
const allBooks = await db.select().from(bibleBooks).orderBy((b) => b.ordine);

const booksOT = allBooks.filter((b) => b.testamento === 'AT');
const booksNT = allBooks.filter((b) => b.testamento === 'NT');

// Popular verses (hardcoded for now, will link to actual verses when populated)
const popularVerses = [
  { reference: 'Giovanni 3:16', title: 'Dio ha tanto amato il mondo', volume: 890 },
  { reference: 'Matteo 6:9-13', title: 'Padre Nostro', volume: 650 },
  { reference: 'Genesi 1:27', title: 'Immagine e somiglianza di Dio', volume: 450 },
  { reference: 'Giovanni 15:5', title: 'Io sono la vite', volume: 380 },
  { reference: 'Luca 1:28', title: 'Ave Maria', volume: 420 },
];

const pageTitle = 'Bibbia CEI Online - La Sacra Bibbia in Italiano';
const pageDescription = 'Leggi la Bibbia CEI 2008 online gratuitamente. 73 libri dell\'Antico e Nuovo Testamento in italiano. Con ricerca, approfondimenti catechistici e citazioni liturgiche.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold mb-4">La Sacra Bibbia</h1>
      <p class="text-xl text-blue-100 mb-6">Bibbia CEI 2008 - 73 libri in italiano</p>

      <!-- Quick Search -->
      <div class="mt-8">
        <input
          type="text"
          placeholder="Cerca un versetto (es. Giovanni 3:16)"
          class="w-full px-6 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-4 focus:ring-yellow-400"
          id="bible-search"
        />
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Testament Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <!-- Antico Testamento -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center">
          <span class="w-1 h-8 bg-amber-600 mr-3"></span>
          Antico Testamento
        </h2>
        <p class="text-gray-600 mb-4">{booksOT.length} libri • {booksOT.reduce((sum, b) => sum + b.numeroCapitoli, 0)} capitoli</p>

        <div class="space-y-2 mb-6">
          {booksOT.map((book) => (
            <a
              href={`/bibbia/${book.slug}`}
              class="block p-3 rounded hover:bg-amber-50 border border-amber-100 hover:border-amber-300 transition"
            >
              <span class="font-semibold text-gray-900">{book.nome}</span>
              <span class="text-sm text-gray-500 ml-2">({book.numeroCapitoli} cap.)</span>
            </a>
          ))}
        </div>

        <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">
          Vedi tutti i libri dell'AT →
        </a>
      </div>

      <!-- Nuovo Testamento -->
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center">
          <span class="w-1 h-8 bg-red-600 mr-3"></span>
          Nuovo Testamento
        </h2>
        <p class="text-gray-600 mb-4">{booksNT.length} libri • {booksNT.reduce((sum, b) => sum + b.numeroCapitoli, 0)} capitoli</p>

        <div class="space-y-2 mb-6">
          {booksNT.map((book) => (
            <a
              href={`/bibbia/${book.slug}`}
              class="block p-3 rounded hover:bg-red-50 border border-red-100 hover:border-red-300 transition"
            >
              <span class="font-semibold text-gray-900">{book.nome}</span>
              <span class="text-sm text-gray-500 ml-2">({book.numeroCapitoli} cap.)</span>
            </a>
          ))}
        </div>

        <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">
          Vedi tutti i libri del NT →
        </a>
      </div>
    </div>

    <!-- Popular Verses Section -->
    <div class="bg-gray-50 rounded-lg p-8 mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Versetti Più Letti</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularVerses.map((verse) => (
          <div class="bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-300 transition">
            <p class="text-sm font-mono text-blue-600 font-semibold">{verse.reference}</p>
            <p class="text-gray-700 mt-2">{verse.title}</p>
            <p class="text-xs text-gray-500 mt-2">~{verse.volume} ricerche/mese</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Info Sections -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-blue-50 p-6 rounded-lg border border-blue-200">
        <h3 class="text-lg font-bold text-gray-900 mb-2">📖 Versione CEI 2008</h3>
        <p class="text-gray-700">La versione ufficiale della Conferenza Episcopale Italiana, approvata dalla Chiesa cattolica.</p>
      </div>

      <div class="bg-green-50 p-6 rounded-lg border border-green-200">
        <h3 class="text-lg font-bold text-gray-900 mb-2">🔗 Collegamenti al Catechismo</h3>
        <p class="text-gray-700">Ogni versetto è collegato alle sezioni corrispondenti del Catechismo della Chiesa Cattolica.</p>
      </div>

      <div class="bg-purple-50 p-6 rounded-lg border border-purple-200">
        <h3 class="text-lg font-bold text-gray-900 mb-2">⛪ Liturgia Cattolica</h3>
        <p class="text-gray-700">Scopri quando ogni versetto viene proclamato nella Messa della Chiesa cattolica.</p>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-gray-100 py-3 px-4 mt-8">
    <div class="max-w-6xl mx-auto text-sm">
      <ol class="flex space-x-2">
        <li><a href="/" class="text-blue-600 hover:text-blue-800">Home</a></li>
        <li class="text-gray-500">/</li>
        <li class="text-gray-700 font-semibold">Bibbia</li>
      </ol>
    </div>
  </nav>
</BaseLayout>

<script>
  const searchInput = document.getElementById('bible-search') as HTMLInputElement;

  if (searchInput) {
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && searchInput.value) {
        // TODO: Implement search functionality
        // For now, show placeholder message
        console.log('Cercare:', searchInput.value);
      }
    });
  }
</script>
