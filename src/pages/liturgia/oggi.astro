---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
const db = getDb(Astro.locals);
import { format } from 'date-fns';
import { it } from 'date-fns/locale';
import { getLiturgicalInfo } from '../../lib/liturgy';

export const prerender = false;

const oggi = format(new Date(), 'yyyy-MM-dd');
const oggiFormat = format(new Date(), 'EEEE d MMMM yyyy', { locale: it });

const liturgia = await db.query.liturgy.findFirst({
  where: (t, { eq }) => eq(t.data, oggi),
});

// Santi del giorno
const santiOggi = liturgia?.santiDelGiorno?.length
  ? await db.query.saints.findMany({
      where: (t, { inArray }) => inArray(t.id, liturgia.santiDelGiorno!),
    })
  : [];

// Santi per data festa (MM-DD)
const meseGiorno = format(new Date(), 'MM-dd');
const santiPerFesta = await db.query.saints.findMany({
  where: (t, { eq }) => eq(t.dataFesta, meseGiorno),
});

// Giorno liturgico calcolato dal motore calendario (sempre disponibile, senza AI né API)
const info = getLiturgicalInfo(new Date());
const COLORI: Record<string, { bg: string; fg: string }> = {
  Verde: { bg: '#dcfce7', fg: '#166534' },
  Viola: { bg: '#ede9fe', fg: '#5b21b6' },
  Bianco: { bg: '#f1f5f9', fg: '#334155' },
  Rosso: { bg: '#fee2e2', fg: '#991b1b' },
  Oro: { bg: '#fef9c3', fg: '#854d0e' },
  Nero: { bg: '#e5e7eb', fg: '#111827' },
};
const col = COLORI[info.color] ?? COLORI.Verde;
---

<BaseLayout
  title="Liturgia di Oggi"
  description={`Liturgia cattolica di oggi ${oggiFormat}. Letture, Salmo, Vangelo e santi del giorno.`}
>
  <div class="max-w-3xl mx-auto">
    <header class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 font-serif">Liturgia di Oggi</h1>
      <p class="text-xl text-muted-foreground capitalize">{oggiFormat}</p>
    </header>

    <!-- Giorno liturgico (motore calendario — sempre disponibile) -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
      <span class="px-4 py-2 rounded-full text-sm font-semibold" style={`background:${col.bg};color:${col.fg}`}>
        {info.color}
      </span>
      <span class="text-sm text-muted-foreground">Tempo di {info.season}</span>
      {info.title && <span class="text-sm font-semibold">{info.title}</span>}
    </div>

    {liturgia ? (
      <article>
        <!-- Prima Lettura -->
        <section class="mb-8">
          <div class="rounded-lg border bg-card p-6">
            <h2 class="text-xl font-bold mb-3 font-serif">Prima Lettura</h2>
            <p class="text-sm text-primary font-semibold mb-3">{liturgia.primaLettura.riferimento}</p>
            <p class="leading-relaxed whitespace-pre-line">{liturgia.primaLettura.testo}</p>
          </div>
        </section>

        <!-- Salmo -->
        <section class="mb-8">
          <div class="rounded-lg border bg-card p-6">
            <h2 class="text-xl font-bold mb-3 font-serif">Salmo Responsoriale</h2>
            <p class="text-sm text-primary font-semibold mb-2">{liturgia.salmoResponsoriale.riferimento}</p>
            {liturgia.salmoResponsoriale.ritornello && (
              <p class="italic text-muted-foreground mb-3">Rit: {liturgia.salmoResponsoriale.ritornello}</p>
            )}
            <p class="leading-relaxed whitespace-pre-line">{liturgia.salmoResponsoriale.testo}</p>
          </div>
        </section>

        <!-- Seconda Lettura -->
        {liturgia.secondaLettura && (
          <section class="mb-8">
            <div class="rounded-lg border bg-card p-6">
              <h2 class="text-xl font-bold mb-3 font-serif">Seconda Lettura</h2>
              <p class="text-sm text-primary font-semibold mb-3">{liturgia.secondaLettura.riferimento}</p>
              <p class="leading-relaxed whitespace-pre-line">{liturgia.secondaLettura.testo}</p>
            </div>
          </section>
        )}

        <!-- Vangelo -->
        <section class="mb-8">
          <div class="rounded-lg border-2 border-primary/20 bg-gradient-to-br from-background to-primary/5 p-6">
            <h2 class="text-xl font-bold mb-3 font-serif">Vangelo</h2>
            <p class="text-sm text-primary font-semibold mb-3">{liturgia.vangelo.riferimento}</p>
            <p class="text-lg leading-relaxed whitespace-pre-line">{liturgia.vangelo.testo}</p>
          </div>
        </section>
      </article>
    ) : (
      <div class="text-center py-12">
        <p class="text-4xl mb-4">📖</p>
        <p class="text-lg text-muted-foreground mb-4">
          Le letture complete di oggi saranno disponibili a breve.
        </p>
        <p class="text-sm text-muted-foreground">
          Intanto trovi qui sopra il giorno liturgico e i santi di oggi.
        </p>
      </div>
    )}

    <!-- Santi del giorno -->
    {(santiOggi.length > 0 || santiPerFesta.length > 0) && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold mb-6 font-serif">Santi di Oggi</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {[...santiOggi, ...santiPerFesta]
            .filter((s, i, arr) => arr.findIndex(x => x.id === s.id) === i)
            .map(santo => (
              <a href={`/santi/${santo.slug}`} class="flex items-center gap-4 p-4 rounded-lg border bg-card hover:shadow-md transition">
                <div>
                  <h3 class="font-bold">{santo.nome}</h3>
                  {santo.titolo && <p class="text-sm text-muted-foreground">{santo.titolo}</p>}
                </div>
              </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
