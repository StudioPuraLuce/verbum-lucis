---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db';

export const prerender = false;

const santi = await db.query.saints.findMany({
  orderBy: (saints, { asc }) => [asc(saints.nome)],
});

// Raggruppa per lettera iniziale
const grouped: Record<string, typeof santi> = {};
for (const santo of santi) {
  const letter = santo.nome.charAt(0).toUpperCase();
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(santo);
}
const letters = Object.keys(grouped).sort();
---

<BaseLayout
  title="Santi e Beati"
  description="Elenco completo dei santi e beati della Chiesa Cattolica. Scopri la vita, le preghiere e i patronati di ogni santo."
>
  <div class="max-w-4xl mx-auto">
    <header class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 font-serif">Santi e Beati</h1>
      <p class="text-lg text-muted-foreground">
        Scopri la vita e le preghiere dei santi della Chiesa Cattolica
      </p>
      <p class="text-sm text-muted-foreground mt-2">{santi.length} santi nel database</p>
    </header>

    <!-- Indice alfabetico -->
    <nav class="flex flex-wrap justify-center gap-2 mb-8">
      {letters.map(letter => (
        <a href={`#${letter}`} class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium hover:bg-primary/20 transition">
          {letter}
        </a>
      ))}
    </nav>

    <!-- Lista santi -->
    {letters.map(letter => (
      <section id={letter} class="mb-8">
        <h2 class="text-2xl font-bold mb-4 font-serif border-b pb-2">{letter}</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {grouped[letter].map(santo => (
            <a
              href={`/santi/${santo.slug}`}
              class="flex items-center gap-4 p-4 rounded-lg border bg-card hover:shadow-md transition"
            >
              {santo.immagineUrl && (
                <img src={santo.immagineUrl} alt={santo.nome} class="w-12 h-12 rounded-full object-cover" />
              )}
              <div>
                <h3 class="font-bold">{santo.nome}</h3>
                {santo.titolo && <p class="text-sm text-muted-foreground">{santo.titolo}</p>}
                <p class="text-xs text-muted-foreground mt-1">Festa: {santo.dataFesta}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
