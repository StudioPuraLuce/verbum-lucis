---
// Anteprima interna del Componitore Giornaliero (strumento di lavorazione, non pubblico).
// /admin/componitore?data=2025-04-21   (default: oggi)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { componiGiornata, type AtomoScelto } from '../../lib/componitore';
import { format } from 'date-fns';

const db = getDb(Astro.locals);
const dataParam = Astro.url.searchParams.get('data') || format(new Date(), 'yyyy-MM-dd');
const g = await componiGiornata(db, dataParam);
const c = g.coordinata;

const sezioni: { titolo: string; atomi: AtomoScelto[] }[] = [
  { titolo: 'Meditazioni', atomi: g.meditazioni },
  { titolo: 'Preghiere', atomi: g.preghiere },
  { titolo: 'Gesti', atomi: g.gesti },
  { titolo: 'Frasi', atomi: g.frasi },
  { titolo: 'Simboli', atomi: g.simboli },
  { titolo: 'Insegnamenti', atomi: g.insegnamenti },
];
---

<BaseLayout title="Componitore (anteprima)" description="Anteprima interna del Componitore Giornaliero">
  <section class="mx-auto max-w-3xl py-10">
    <span class="kicker text-gold">Componitore · anteprima</span>
    <h1 class="font-display text-4xl text-foreground">{g.data}</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      {c.tempoLabel}{c.settimanaRomana ? ` · ${c.settimanaRomana}` : ''} · Anno {c.cicloDomenicale}
      · {c.vangeloTonalita.evangelista}{c.centro ? ` · ${c.centro}` : ''} · colore {c.colore}
      <br />candidati: {g.nCandidati}
    </p>

    <form method="get" class="mt-4 flex gap-2">
      <input type="date" name="data" value={g.data}
        class="rounded-md border border-gold/30 bg-card px-3 py-1.5 text-sm" />
      <button class="rounded-md bg-primary px-4 py-1.5 text-sm font-medium text-primary-foreground">Componi</button>
    </form>

    {sezioni.map((s) => (
      <div class="mt-8">
        <h2 class="font-display text-2xl text-gold">{s.titolo} <span class="text-sm text-muted-foreground">({s.atomi.length})</span></h2>
        {s.atomi.length === 0 && <p class="text-sm text-muted-foreground">—</p>}
        <ul class="mt-3 space-y-3">
          {s.atomi.map((a) => (
            <li class="rounded-lg border border-gold/15 bg-card p-4">
              {a.titolo && <p class="text-xs uppercase tracking-wide text-gold">{a.titolo}</p>}
              <p class="mt-1 whitespace-pre-line font-serif text-foreground">{a.testo}</p>
              <p class="mt-2 text-xs text-muted-foreground">
                {a.data ?? '—'}{a.vangelo ? ` · ${a.vangelo}` : ''}{a.qualita != null ? ` · q${a.qualita}` : ''}
                {a.tags.length ? ` · ${a.tags.slice(0, 4).join(', ')}` : ''}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
